rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPrincipal() {
      return isSignedIn() && userDoc().data.role == 'principal';
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && userDoc().data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && userDoc().data.role == 'student';
    }

    function isParent() {
      return isSignedIn() && userDoc().data.role == 'parent';
    }

    function isStaff() {
      return isPrincipal() || isTeacher() || isAdmin();
    }

    function parentLinkedTo(studentId) {
      let u = userDoc().data;
      return isParent() && (
        u.linkedStudentId == studentId
        || (u.linkedStudentIds != null && studentId in u.linkedStudentIds)
      );
    }

    function isOwner(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    function studentParentUid(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.parentUid;
    }

    function parentOwnsStudent(studentId) {
      return isParent() && studentParentUid(studentId) == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /parents/{parentId} {
      allow read, write: if isSignedIn() && request.auth.uid == parentId;
      allow read: if isStaff();
    }

    match /classes/{classId} {
      allow read: if isPrincipal() || isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, update, delete: if isPrincipal() || isAdmin();
    }

    match /students/{studentId} {
      allow read: if isStaff()
        || isOwner(studentId)
        || parentLinkedTo(studentId)
        || parentOwnsStudent(studentId);
      allow create, update: if isStaff();
      allow delete: if isPrincipal() || isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isStaff()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isParent() && parentOwnsStudent(resource.data.studentId));
      allow create, update: if isStaff();
      allow delete: if isPrincipal() || isAdmin();
    }

    match /attendance/{date}/classes/{classId}/students/{studentId} {
      allow read: if isStaff() || parentOwnsStudent(studentId) || isOwner(studentId);
      allow create, update: if isPrincipal() || isAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isPrincipal() || isAdmin();
    }

    match /uploadHistory/{teacherId}/logs/{logId} {
      allow read, create: if isSignedIn() && request.auth.uid == teacherId;
      allow update, delete: if isPrincipal() || isAdmin();
    }

    match /marks/{studentId}/entries/{entryId} {
      allow read: if isStaff()
        || isOwner(studentId)
        || parentLinkedTo(studentId)
        || parentOwnsStudent(studentId);
      allow write: if isStaff();
    }

    match /weakTopics/{studentId}/topics/{topicId} {
      allow read: if isOwner(studentId)
        || parentLinkedTo(studentId)
        || parentOwnsStudent(studentId)
        || isStaff();
      allow write: if isStaff();
    }

    match /activityLog/{studentId}/logs/{logId} {
      allow read: if isOwner(studentId)
        || parentLinkedTo(studentId)
        || parentOwnsStudent(studentId)
        || isStaff();
      allow write: if isStaff();
    }

    match /studyTasks/{taskId} {
      allow read, update, delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if isStaff()
        || isSignedIn();
      allow write: if isStaff();
    }

    match /notes/{ownerId}/students/{studentId}/items/{noteId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == ownerId;
      allow read: if isStaff();
    }

    match /assignments/{assignmentId}/submissions/{submissionId} {
      allow read: if isStaff()
        || isOwner(resource.data.studentId)
        || parentOwnsStudent(resource.data.studentId);
      allow create, update: if isOwner(request.resource.data.studentId);
    }
  }
}
