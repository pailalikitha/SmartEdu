rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && userDoc().data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && userDoc().data.role == 'student';
    }

    function isParent() {
      return isSignedIn() && userDoc().data.role == 'parent';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Parents
    function parentOwnsStudent(studentId) {
      return isParent() && get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid;
    }

    function parentLinkedTo(studentId) {
      let u = userDoc().data;
      return isParent() && (
        u.linkedStudentId == studentId
        || (u.linkedStudentIds != null && studentId in u.linkedStudentIds)
      );
    }
    
    function isLinkedParent(studentId) {
      return parentOwnsStudent(studentId) || parentLinkedTo(studentId);
    }

    // Teachers
    function isTeacherOfClass(classId) {
      return isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isTeacherOfStudent(studentId) {
      let studentClassId = get(/databases/$(database)/documents/students/$(studentId)).data.classId;
      return studentClassId != null && isTeacherOfClass(studentClassId);
    }

    // Students
    function isStudentInClass(classId) {
      return isStudent() && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId == classId;
    }

    // Fallback: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, write: if isOwner(teacherId) || isAdmin();
    }

    match /parents/{parentId} {
      allow read, write: if isOwner(parentId) || isAdmin();
    }

    match /parents/{parentId}/alertSettings/{settingId} {
      allow read, write: if isOwner(parentId) || isAdmin();
    }

    match /students/{studentId} {
      allow read: if isOwner(studentId) || isLinkedParent(studentId) || isTeacherOfStudent(studentId) || isAdmin();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAdmin() || isTeacherOfClass(classId) || isStudentInClass(classId) || isParent();
      allow write: if isAdmin() || isTeacherOfClass(classId);
    }

    match /marks/{studentId}/entries/{entryId} {
      allow read: if isOwner(studentId) || isLinkedParent(studentId) || isTeacherOfStudent(studentId) || isAdmin();
      allow write: if isTeacherOfStudent(studentId) || isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin() 
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isParent() && isLinkedParent(resource.data.studentId))
        || (isTeacher() && isTeacherOfStudent(resource.data.studentId));
      allow update, delete: if isAdmin() || (isTeacher() && isTeacherOfStudent(resource.data.studentId));
      allow create: if isAdmin() || (isTeacher() && isTeacherOfStudent(request.resource.data.studentId));
    }

    match /attendance/{date}/classes/{classId}/students/{studentId} {
      allow read: if isOwner(studentId) || isLinkedParent(studentId) || isTeacherOfClass(classId) || isAdmin();
      allow write: if isTeacherOfClass(classId) || isAdmin();
    }

    match /studyTasks/{taskId} {
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.studentId == request.auth.uid);
    }

    match /weakTopics/{studentId}/topics/{topicId} {
      allow read: if isOwner(studentId) || isLinkedParent(studentId) || isTeacherOfStudent(studentId) || isAdmin();
      allow write: if isAdmin() || isTeacherOfStudent(studentId);
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() || isTeacherOfClass(resource.data.classId) || isStudentInClass(resource.data.classId) || isParent();
      allow update, delete: if isAdmin() || isTeacherOfClass(resource.data.classId);
      allow create: if isAdmin() || isTeacherOfClass(request.resource.data.classId);
    }

    match /assignments/{assignmentId}/submissions/{submissionId} {
      allow read: if isAdmin() 
        || (isSignedIn() && resource.data.studentId == request.auth.uid) 
        || isTeacherOfClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId) 
        || (isParent() && isLinkedParent(resource.data.studentId));
      allow update, delete: if isAdmin() 
        || (isSignedIn() && resource.data.studentId == request.auth.uid) 
        || isTeacherOfClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId);
      allow create: if isAdmin() 
        || (isSignedIn() && request.resource.data.studentId == request.auth.uid) 
        || isTeacherOfClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId);
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /notes/{teacherId}/students/{studentId}/items/{noteId} {
      allow read, write: if isAdmin() || isOwner(teacherId);
    }
  }
}
