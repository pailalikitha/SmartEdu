# ─── Firebase (client — safe to expose in the browser) ───
# Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI (server only — used by /api/anthropic) ───
ANTHROPIC_API_KEY=

# ─── Setup ───
# 1. cp .env.example .env.local
# 2. Paste Firebase config values into .env.local
# 3. Firebase Console → Authentication → Sign-in method → Enable Email/Password
# 4. Firebase Console → Firestore → Create database
# 5. Deploy Firestore rules and composite indexes (required for filtered queries):
#    firebase deploy --only firestore:rules,firestore:indexes
#    (copy firestore.rules.example → firestore.rules first, or merge into your rules file)
# 6. Optional: set FIREBASE_SERVICE_ACCOUNT_JSON for parent account creation on student CSV upload
# 7. Restart: npm run dev
